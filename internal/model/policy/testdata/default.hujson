// Synthetic. Shaped like a new tailnet's untouched policy:
// everything reaches everything, plus SSH into your own devices.
{
	"grants": [
		// Every device, every port.
		{"src": ["*"], "dst": ["*"], "ip": ["*"]},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
