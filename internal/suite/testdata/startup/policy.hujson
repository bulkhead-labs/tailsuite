// Synthetic. A small startup's policy, with one rule headscale can't take.
{
	"groups": {"group:eng": ["alice@example.com", "bob@example.com"]},
	"tagOwners": {"tag:prod": ["autogroup:admin"], "tag:db": ["autogroup:admin"]},
	"ipsets": {"ipset:office": ["add 192.0.2.0/24"]},
	"grants": [
		// Engineers reach the web tier over HTTP.
		{"src": ["group:eng"], "dst": ["tag:prod"], "ip": ["tcp:80"]},
		// The web tier reaches the database.
		{"src": ["tag:prod"], "dst": ["tag:db"], "ip": ["tcp:5432"]},
		// Bob reaches the office LAN: an IP set, which headscale refuses.
		{"src": ["bob@example.com"], "dst": ["ipset:office"], "ip": ["*"]},
	],
	"tests": [
		{"src": "alice@example.com", "accept": ["tag:prod:80"], "deny": ["tag:db:5432"]},
		{"src": "carol@example.com", "accept": ["tag:prod:80"]},
	],
}
